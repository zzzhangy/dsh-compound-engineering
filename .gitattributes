# 统一行尾：脚本与源码一律 LF，避免 Windows 检出后 .sh 出现
# `bad interpreter: /bin/bash^M`、以及 Python 脚本混入 \r。
* text=auto eol=lf

# 明确需要可执行位的文件
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf

# 二进制资产不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.zst binary
